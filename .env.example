# Obtain a token from @BotFather. Never commit the real .env file.
BOT_TOKEN=
# Optional: comma-separated numeric Telegram user IDs.
ADMIN_TELEGRAM_IDS=
BOT_STAGE=lab3
SQLITE_PATH=runtime/bot.db
CSV_PATH=data/ploswater.csv
LOG_PATH=runtime/logs/bot.log
# Final Lab 2/3 deployment: polling, scientific APIs and opt-in paid AI through LiteLLM.
# Each user still controls their personal AI preference using /ai.
ENABLE_EXTERNAL_SOURCES=true
ENABLE_AI=true

# Local E5 uses already cached model files only. /admin overrides are stored in SQLite.
ENABLE_SEMANTIC_SEARCH=true
SEMANTIC_MODEL=intfloat/multilingual-e5-small
SEMANTIC_REVISION=614241f622f53c4eeff9890bdc4f31cfecc418b3
SEMANTIC_INDEX_DIR=runtime/semantic
SEMANTIC_TIMEOUT_SECONDS=3
SEMANTIC_BUILD_TIMEOUT_SECONDS=180
SEMANTIC_BATCH_SIZE=4
SEMANTIC_CPU_THREADS=4
SEMANTIC_MIN_SCORE=0.83
SEMANTIC_SCORE_MARGIN=0.018
SEMANTIC_CANDIDATES=20
FUZZY_MIN_SCORE=88
FTS_WEIGHT=1
FUZZY_WEIGHT=0.5
SEMANTIC_WEIGHT=1
RRF_K=60
HISTORY_MAX_PER_USER=50
HISTORY_DAYS=30
# Optional external E5 reranking; independent from local E5.
ENABLE_EXTERNAL_SEMANTIC_RANKING=false

# Lab 2/3: bot.py defaults to Lab 3. The original --stage lab1 requires Lab 1 flags.
# For scientific APIs use: python bot.py --external
OPENALEX_API_KEY=
OPENAI_API_KEY=
CROSSREF_CONTACT_EMAIL=
ENABLE_TRANSLATION=true
TRANSLATION_TIMEOUT_SECONDS=12
API_TIMEOUT_SECONDS=12
LITELLM_URL=http://127.0.0.1:4000
LITELLM_MASTER_KEY=
LITELLM_SALT_KEY=
POSTGRES_USER=litellm
POSTGRES_PASSWORD=
POSTGRES_DB=litellm
DEFAULT_USER_BUDGET_USD=0.50
ADMIN_ANALYSIS_BUDGET_USD=0.50
LLM_PRIMARY_MODEL=research-basic
LLM_FALLBACK_MODEL=research-complex
ENABLE_SOL_FALLBACK=false
MAX_AI_OUTPUT_TOKENS=350
LLM_TIMEOUT_SECONDS=20
BOT_RUN_MODE=polling
WEBHOOK_LISTEN_HOST=127.0.0.1
WEBHOOK_PORT=8080
WEBHOOK_PATH=
WEBHOOK_SECRET_TOKEN=
NGROK_AUTHTOKEN=
NGROK_PUBLIC_URL=
# prepare_services.py creates stable generated secrets in ignored runtime/.
# OpenAI key is passed only to LiteLLM; Telegram credentials never enter Compose.
