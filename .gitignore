# Python: bytecode and native extensions
__pycache__/
*.py[cod]
*$py.class
*.so

# Python: local environments
.venv/
venv/
env/
ENV/

# Python: packaging and build artifacts
build/
dist/
*.egg-info/
.eggs/

# Environment variables and secrets
.env
.env.*
!.env.example
!.env.*.example
*.pem
*.key
credentials.json
secrets.json
service-account*.json

# Local SQLite databases and their journals
*.db
*.db-*
*.sqlite
*.sqlite-*
*.sqlite3
*.sqlite3-*

# Logs and temporary output
*.log
logs/
*.tmp
*.bak
*~
*.swp
tempCodeRunnerFile.py

# Tests, caches and coverage reports
.pytest_cache/
.mypy_cache/
.ruff_cache/
.tox/
.nox/
.cache/
.coverage
.coverage.*
htmlcov/
coverage.xml

# Local editor configuration
.vscode/
.idea/

# Operating system / office temporary files
.DS_Store
Thumbs.db
Desktop.ini
~$*.docx
~$*.xlsx

# Bot runtime, including SQLite WAL and rotating logs
runtime/

